{
  "name": "HoloAirMenu mobile workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp"
      ],
      "settings": {
        "files.exclude": {
          "**/Library": true,
          "**/Temp": true,
          "**/Obj": true
        }
      }
    }
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "HAM white-box preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8080 --bind 0.0.0.0 --directory whitebox > /tmp/ham-preview.log 2>&1 < /dev/null &"
}
